{
  "expo": {
    "name": "Dermis",
    "slug": "dermis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dermis",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.righttail.dermis",
      "appleTeamId": "447FVLNAL3",
      "infoPlist": {
        "NSCameraUsageDescription": "Dermis uses the camera to take a wellness selfie for analysis on our servers.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "owner": "rahat_qadeer",
    "extra": {
      "eas": {
        "projectId": "548ca3a2-4123-4a46-87fa-1b7e1385626e"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6EEDF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Dermis uses the camera to take a wellness selfie for analysis on our servers.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E6EEDF",
          "defaultChannel": "scan-reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#E6EEDF"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
