
# Copy to `.env.local` (gitignored) for real local testing.
# Never commit secrets. Keys: Supabase Project Settings → API.
#
# IMPORTANT: Expo loads EXPO_PUBLIC_* from `apps/mobile/.env.local` (or via
# `apps/mobile/app.config.js` reading this file). Root `.env.local` alone is
# enough for the backend, but mobile needs EXPO_PUBLIC_* visible to Expo.

# ---------------------------------------------------------------------------
# Public mobile (Expo) — no secrets
# Also put these in apps/mobile/.env.local (or rely on app.config.js bridge).
# ---------------------------------------------------------------------------
# Must reach your local backend. Restart Expo after changing.
#   Simulator / same machine:  http://127.0.0.1:8787
#   Android emulator:          http://10.0.2.2:8787
#   Physical phone (Expo Go):  http://YOUR_LAN_IP:8787  (same Wi‑Fi as Mac)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
# Store console Support URL is documented in docs/store/public-urls.md (TODO(spec)).
# EXPO_PUBLIC_SUPPORT_URL=

# Leave empty for real API. Only for UI demos without a session.
EXPO_PUBLIC_MOCK_HOME_SCENARIO=

# RevenueCat (native iOS/Android only — leave empty for web/CI)
EXPO_PUBLIC_REVENUECAT_API_KEY=
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
#
# Local only: unlock all Pro UI locks (zones, routine, progress, full concerns).
# EXPO_PUBLIC_UNLOCK_ALL_FEATURES=1

# Google Sign-In (optional). Both required; enable Google provider in Supabase Auth.
# Without these, social Google shows the email/Pro-unlock test message.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---------------------------------------------------------------------------
# Backend only — loaded by `npm run start --workspace=@dermis/backend`
# (Node --env-file-if-exists=../.env.local). Never put these in apps/mobile.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
#
# Real signup/signin (password → API → Supabase Auth JWT):
#   DERMIS_BACKEND_MEMORY=0
# Offline demo bearers (user:<uuid>:email) only:
#   DERMIS_BACKEND_MEMORY=1
#
# Fake skin scores without Gemini (fine for auth testing):
#   DERMIS_FAKE_ANALYZER=1
# Real face analysis (optional): set GEMINI_API_KEY from Google AI Studio
#   GEMINI_API_KEY=
#   GEMINI_MODEL=gemini-3.8-flash
#   DERMIS_FAKE_ANALYZER=0
#
# REVENUECAT_WEBHOOK_SECRET=
# REVENUECAT_PRO_ENTITLEMENT_ID=pro
# SCAN_PIPELINE_DISABLED=1
# PORT=8787
#
# Local only: paywall Subscribe unlocks Pro via POST /v1/dev/entitlements/pro
# (requires service role + __DEV__ app). Never enable in production.
# DERMIS_ALLOW_DEV_ENTITLEMENT=1
#
# Local only: raise free lifetime scans (default product = 1). Uses relaxed
# quota path in Node instead of SQL RPC limit.
# DERMIS_FREE_LIFETIME_SCANS=100
#
# Local only: treat every account as Pro (UI + quota). Pair with mobile:
#   EXPO_PUBLIC_UNLOCK_ALL_FEATURES=1
# DERMIS_FORCE_PRO=1
